<style>
    /* ---------- KPI cards moved from horizontal collapsible header row into a
       docked right-side panel (request Hendra 2026-08-17: same treatment as
       the Transactions pages). ---------- */
    .dp-layout-row {
        display: flex;
        align-items: stretch;
    }
    .dp-layout-main {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }
    .dp-layout-main .dp-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .dp-stats-toggle {
        position: relative;
        color: #2450D8;
        border-color: #C7D9F7;
        background: #F4F8FF;
    }
    .dp-stats-toggle:hover {
        background: #E7F1FB;
        border-color: #2450D8;
    }

    .dp-stats-panel {
        flex: 0 0 272px;
        width: 272px;
        margin-left: 16px;
        background: #fff;
        border: 1px solid #E3E8EF;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(16,24,40,.04);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: flex-basis .22s cubic-bezier(.4,0,.2,1), width .22s cubic-bezier(.4,0,.2,1),
                    margin-left .22s cubic-bezier(.4,0,.2,1), opacity .18s ease, border-color .22s ease, box-shadow .22s ease;
    }
    .dp-layout-row.stats-collapsed .dp-stats-panel {
        flex-basis: 0;
        width: 0;
        margin-left: 0;
        opacity: 0;
        border-color: transparent;
        box-shadow: none;
        pointer-events: none;
    }

    .dp-stats-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        border-bottom: 1px solid #EEF1F5;
        white-space: nowrap;
    }
    .dp-stats-panel-head span {
        font-size: 14px;
        font-weight: 700;
        color: #101828;
    }
    .dp-stats-panel-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
    }
    .dp-stats-panel-close:hover { color: #475467; }

    .dp-stats-panel-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px 18px;
        white-space: nowrap;
    }
    .dp-stats-panel-body .dp-stat-card {
        width: 100%;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
    }
    .dp-stats-panel-body .dp-stat-card:hover {
        border-color: #D5DDE8;
    }

    @@media (max-width: 900px) {
        .dp-layout-row { flex-direction: column; }
        .dp-stats-toggle { display: none; }
        .dp-stats-panel, .dp-layout-row.stats-collapsed .dp-stats-panel {
            flex-basis: auto; width: 100%; margin-left: 0; opacity: 1; pointer-events: auto;
            border-color: #E3E8EF; box-shadow: 0 4px 14px rgba(16,24,40,.04); margin-top: 16px;
        }
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div class="box-header dp-toolbar">
                            <div class="dp-toolbar-left">
                                @if ((bool)ViewData["Add"])
                                {
                                    <button type="button" class="dp-btn dp-btn-success" id="btn_add"><i class="fa fa-plus"></i> Add Menu</button>
                                }
                            </div>
                            <div class="dp-toolbar-right">
                                <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export</button>
                                <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Menu Summary">
                                    <i class="fa fa-angle-double-left"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mf-layout">
                            <div class="mf-tree-panel">
                                @Html.Partial("_SearchCriteria")
                            </div>
                            <div class="mf-function-panel">
                                @Html.Partial("_GridView")
                            </div>
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Menu Summary</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="mfStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-th-large"></i></div>
                            <div>
                                <span>Total Menu</span>
                                <b id="mfStatMenus">-</b>
                                <small>Menu items</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-cubes"></i></div>
                            <div>
                                <span>Total Function</span>
                                <b id="mfStatFunctions">-</b>
                                <small>Functions</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Used by Roles</span>
                                <b id="mfStatRoles">-</b>
                                <small>Roles</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-toggle-off"></i></div>
                            <div>
                                <span>Inactive</span>
                                <b id="mfStatInactive">-</b>
                                <small>Menu / Function</small>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
