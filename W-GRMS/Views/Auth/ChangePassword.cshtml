@{
    Layout = null;
    bool expired = (bool)ViewData["Expired"];
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GRMS | Change Password</title>
<link rel="icon" type="image/x-icon" href="~/favicon.ico?v=grms" />
<link href="~/css/fonts.css" rel="stylesheet">
<link href="~/css/auth.css" rel="stylesheet">
</head>
<body>
<div class="lg-wrap">
  @await Html.PartialAsync("_AuthHero")

  <main class="lg-main">
    <div class="lg-card">
      <img class="lg-card-logo" src="~/images/grms-logo.png" alt="GRMS">
      <h2>Change Password</h2>
      <p class="lead">Set a new password for your GRMS account</p>

      @if (expired)
      {
        <div class="lg-note" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18h.01"/></svg>
          <span>Your password has expired. Please set a new password to continue.</span>
        </div>
      }
      <div class="lg-user">
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
          @ViewData["UserId"]
        </span>
      </div>

      <form id="pwdForm">
        <div class="field">
          <label for="oldPassword">Old Password</label>
          <div class="input-group">
            <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <input type="password" id="oldPassword" placeholder="Enter old password" autocomplete="current-password" required autofocus>
            <button type="button" class="trailing pw-toggle" data-target="oldPassword" aria-label="Show password" title="Show / hide password"></button>
          </div>
        </div>
        <div class="field">
          <label for="newPassword">New Password</label>
          <div class="input-group">
            <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 7a4 4 0 1 1-4.9 3.9L4 17v3h3l1-1v-2h2l1.5-1.5"/><circle cx="16" cy="8" r=".6"/></svg>
            <input type="password" id="newPassword" placeholder="Enter new password" autocomplete="new-password" required minlength="6">
            <button type="button" class="trailing pw-toggle" data-target="newPassword" aria-label="Show password" title="Show / hide password"></button>
          </div>
          <p class="pw-hint">Minimum 6 characters, different from the old password.</p>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm New Password</label>
          <div class="input-group">
            <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l4 4 10-10"/></svg>
            <input type="password" id="confirmPassword" placeholder="Repeat new password" autocomplete="new-password" required>
            <button type="button" class="trailing pw-toggle" data-target="confirmPassword" aria-label="Show password" title="Show / hide password"></button>
          </div>
        </div>

        <button type="submit" class="btn-login" id="btn_save">
          <svg class="lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span id="btnText">Save Password</span>
          <span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </button>
      </form>

      @if (expired)
      {
        <a class="lg-back" href="@Url.Action("Logout", "Auth")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          Back to login
        </a>
      }
      else
      {
        <a class="lg-back" href="@Url.Action("Index", "Home")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          Back to dashboard
        </a>
      }

    </div>
  </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js"></script>
<script src="~/js/site.js"></script>
<script>
  var EYE_OPEN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
  var EYE_OFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.4 10.4 0 0 1 12 5c7 0 10 7 10 7a17 17 0 0 1-3.2 4.2M6.6 6.6C3.9 8.3 2 12 2 12s3 7 10 7a9.9 9.9 0 0 0 5.4-1.6"/></svg>';

  $('.pw-toggle').html(EYE_OFF).on('click', function () {
    var input = document.getElementById($(this).data('target'));
    var show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    $(this).html(show ? EYE_OPEN : EYE_OFF).attr('aria-label', show ? 'Hide password' : 'Show password');
  });

  function setBusy(busy) {
    $('#btn_save').prop('disabled', busy);
    $('#btnText').text(busy ? 'Saving...' : 'Save Password');
  }

  $('#pwdForm').on('submit', function (e) {
    e.preventDefault();
    $('.bootstrap-growl').remove();

    if ($('#newPassword').val().length < 6) {
      showErrorMesgGrowl('New password must be at least 6 characters');
      return;
    }
    if ($('#newPassword').val() !== $('#confirmPassword').val()) {
      showErrorMesgGrowl('Confirm password does not match');
      return;
    }

    setBusy(true);
    $.ajax({
      type: "POST",
      url: '@Url.Action("SavePassword", "Auth")',
      data: {
        OLD_PASSWORD: $('#oldPassword').val(),
        PASSWORD: $('#newPassword').val(),
        CONFIRM_PASSWORD: $('#confirmPassword').val()
      },
      success: function (result) {
        if (result.status == true) {
          showSuccessMesgGrowl(result.message);
          setTimeout(function () { window.location.href = result.data; }, 800);
        } else {
          setBusy(false);
          showErrorMesgGrowl(result.message);
        }
      },
      error: function () {
        setBusy(false);
        showErrorMesgGrowl('Failed to save password');
      }
    });
  });
</script>
</body>
</html>
