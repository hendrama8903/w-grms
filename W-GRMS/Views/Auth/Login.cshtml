@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GRMS | Login</title>
<link rel="icon" type="image/x-icon" href="~/favicon.ico?v=grms" />
<link href="~/css/fonts.css" rel="stylesheet">
<link href="~/css/auth.css" rel="stylesheet">
</head>
<body>
<div class="lg-wrap">
  @await Html.PartialAsync("_AuthHero")

  <main class="lg-main">
    <div class="lg-card">
      <img class="lg-card-logo" src="~/images/grms-logo.png" alt="GRMS">
      <h2>Welcome Back!</h2>
      <p class="lead">Sign in to access Goods Receiving Management System</p>

      <form id="loginForm" autocomplete="on">
        <div class="field">
          <label for="username">Username</label>
          <div class="input-group">
            <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
            <input type="text" id="username" name="username" placeholder="Enter your username" autocomplete="username" required autofocus>
          </div>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="input-group">
            <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
            <button type="button" class="trailing" id="togglePw" aria-label="Show password" title="Show / hide password">
              <svg id="icoEye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.4 10.4 0 0 1 12 5c7 0 10 7 10 7a17 17 0 0 1-3.2 4.2M6.6 6.6C3.9 8.3 2 12 2 12s3 7 10 7a9.9 9.9 0 0 0 5.4-1.6"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-login" id="btn_login">
          <svg class="lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span id="btnText">Sign In</span>
          <span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </button>
      </form>

    </div>
  </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js"></script>
<script src="~/js/site.js"></script>

<script>
  var EYE_OPEN = '<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>';
  var EYE_OFF = document.getElementById('icoEye').innerHTML;

  document.getElementById('togglePw').addEventListener('click', function () {
    var pw = document.getElementById('password');
    var show = pw.type === 'password';
    pw.type = show ? 'text' : 'password';
    document.getElementById('icoEye').innerHTML = show ? EYE_OPEN : EYE_OFF;
    this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    Validate();
  });

  function setBusy(busy) {
    $("#btn_login").prop("disabled", busy);
    $("#btnText").text(busy ? "Signing in..." : "Sign In");
  }

  function Validate() {
    setBusy(true);
    $('.bootstrap-growl').remove();

    $.ajax({
      type: "POST",
      url: '@Url.Action("Validate", "Auth")',
      data: {
        USER_ID: $("#username").val(),
        PASSWORD: $('#password').val(),
        param: @Json.Serialize(ViewData["ParamURL"] as string)
      },
      error: function () {
        setBusy(false);
        showErrorMesgGrowl("Login failed, please try again");
      },
      success: function (result) {
        if (result.status == true) {
          if (result.expired == true) { window.location.href = '@Url.Action("ChangePassword", "Auth")'; return; }
          var redirectUrl = result.data != null ? result.data : '@Url.Action("Index", "Home")';
          $.bootstrapGrowl('Login successful, redirecting...', {
            type: 'success',
            allow_dismiss: false,
            align: 'right',
            delay: 1200
          });
          setTimeout(function () {
            window.location.href = redirectUrl;
          }, 600);
        } else {
          setBusy(false);
          showErrorMesgGrowl(result.message);
        }
      }
    });
  }
</script>
</body>
</html>
