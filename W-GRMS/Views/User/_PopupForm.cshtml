<style>
    #modalAddEdit .modal-content.adf-modal-content { border: none; border-radius: 14px; overflow: hidden; }
    #modalAddEdit .adf-header {
        background: linear-gradient(135deg, #2450D8, #1C3FA6);
        color: #fff;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    #modalAddEdit .adf-header-icon {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    #modalAddEdit .adf-header-title { font-size: 15.5px; font-weight: 700; margin: 0; }
    #modalAddEdit .adf-header-sub { font-size: 11.5px; color: rgba(255,255,255,.85); margin: 2px 0 0; }
    #modalAddEdit .adf-close {
        margin-left: auto;
        background: transparent;
        border: none;
        color: rgba(255,255,255,.9);
        font-size: 18px;
        padding: 6px;
        cursor: pointer;
        align-self: flex-start;
    }
    #modalAddEdit .modal-dialog { width: 720px; max-width: 96vw; }
    #modalAddEdit .modal-body { padding: 20px 24px; background: #F4F6F8; max-height: 66vh; overflow-y: auto; }

    #modalAddEdit .uf-section { margin-bottom: 18px; }
    #modalAddEdit .uf-section-title { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 700; color: #1D2939; margin-bottom: 3px; }
    #modalAddEdit .uf-section-icon {
        flex: none; width: 26px; height: 26px; border-radius: 7px;
        background: #E7F1FB; color: #2450D8;
        display: flex; align-items: center; justify-content: center; font-size: 12px;
    }
    #modalAddEdit .uf-section-sub { font-size: 11.5px; color: #98A2B3; margin: 0 0 14px 35px; }
    #modalAddEdit .uf-row { display: flex; gap: 16px; margin-bottom: 14px; }
    #modalAddEdit .uf-row > div { flex: 1; min-width: 0; }
    #modalAddEdit .uf-field label { display: block; font-size: 12px; font-weight: 600; color: #26314f; margin-bottom: 5px; }
    #modalAddEdit .uf-field input,
    #modalAddEdit .uf-field select.form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1.5px solid #D0D6DE;
        border-radius: 8px;
        font-size: 12.5px;
        color: #1D2939;
        height: auto;
    }
    #modalAddEdit .uf-field input:focus { border-color: #2450D8; outline: none; box-shadow: 0 0 0 3px rgba(36,80,216,.12); }
    #modalAddEdit .uf-field input[readonly] { background: #EEF1F5; }
    #modalAddEdit .select2-container { width: 100% !important; }
    #modalAddEdit .select2-container .select2-selection--single,
    #modalAddEdit .select2-container .select2-selection--multiple { min-height: 35px; border: 1.5px solid #D0D6DE; border-radius: 8px; }
    #modalAddEdit .select2-container .select2-selection__rendered { line-height: 33px; font-size: 12.5px; }
    #modalAddEdit .select2-container .select2-selection__arrow { height: 33px; }
    /* multi-select (Receiving Areas): kotak ketik select2 jangan ikut style isian form */
    #modalAddEdit .select2-selection--multiple .select2-selection__rendered { line-height: normal; padding: 3px 8px; }
    #modalAddEdit .uf-field .select2-search--inline .select2-search__field {
        width: auto; border: none; border-radius: 0; padding: 0; margin-top: 5px; height: 22px; box-shadow: none; background: transparent;
    }
    #modalAddEdit .select2-selection--multiple .select2-selection__choice {
        background: #E7F1FB; border: 1px solid #C7DBF5; color: #1C3FA6; border-radius: 999px; padding: 1px 10px; margin-top: 4px; font-weight: 600;
    }
    #modalAddEdit .select2-selection--multiple .select2-selection__choice__remove { color: #1C3FA6; margin-right: 4px; }
    #modalAddEdit .uf-hint { font-size: 11.5px; color: #98A2B3; margin-top: 5px; }
    #modalAddEdit .uf-divider { border-top: 1px solid #E3E8EE; margin: 18px 0; }
    #modalAddEdit .modal-footer { background: #fff; border-top: 1px solid #E3E8EE; padding: 14px 22px; margin: 0; }

    @@media (max-width: 600px) {
        #modalAddEdit .uf-row { flex-direction: column; gap: 14px; }
    }
</style>

<div class="modal fade" id="modalAddEdit" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-user-plus"></i></div>
                <div>
                    <h4 class="adf-header-title" id="modal-title">Add User</h4>
                    <p class="adf-header-sub">User account, role and receiving area access.</p>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="uf-section">
                    <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-id-badge"></i></span> User Information</div>
                    <div class="uf-row" style="margin-top:14px;">
                        <div class="uf-field">
                            <label>User ID <span class="text-red">*</span></label>
                            <input id="addEditUserId" type="text" placeholder="Login user ID" maxlength="10" oninput="this.value = this.value.replace(/\s/g, '')" />
                        </div>
                        <div class="uf-field">
                            <label>NIK</label>
                            <input id="addEditNik" type="text" placeholder="Employee number" maxlength="20" />
                        </div>
                    </div>
                    <div class="uf-row">
                        <div class="uf-field">
                            <label>Name <span class="text-red">*</span></label>
                            <input id="addEditUserName" type="text" placeholder="Full name" maxlength="30" />
                        </div>
                    </div>
                    <div class="uf-row">
                        <div class="uf-field">
                            <label>Department</label>
                            <input id="addEditDept" type="text" placeholder="Department" maxlength="60" />
                        </div>
                    </div>
                    <div class="uf-row">
                        <div class="uf-field">
                            <label>Email</label>
                            <input id="addEditEmail" type="text" placeholder="Email address" maxlength="255" />
                        </div>
                        <div class="uf-field">
                            <label>Phone</label>
                            <input id="addEditPhone" type="text" placeholder="Phone number" maxlength="15" />
                        </div>
                    </div>
                </div>

                <div class="uf-divider"></div>

                <div class="uf-section">
                    <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-key"></i></span> Access</div>
                    <div class="uf-row" style="margin-top:14px;">
                        <div class="uf-field">
                            <label>Role <span class="text-red">*</span></label>
                            <select class="form-control" id="addEditRoleId"></select>
                        </div>
                    </div>
                    <div class="uf-row">
                        <div class="uf-field">
                            <label>Receiving Areas</label>
                            <select class="form-control" id="addEditPlants" multiple="multiple"></select>
                            <div class="uf-hint">Type to search. The list comes from Master Data &gt; Receiving Area.</div>
                        </div>
                    </div>
                </div>

                <div class="uf-divider"></div>

                <div class="uf-section">
                    <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-lock"></i></span> Password</div>
                    <div class="uf-section-sub" id="passwordHint">Leave empty to use the User ID as initial password.</div>
                    <div class="uf-row">
                        <div class="uf-field">
                            <label>Password</label>
                            <input id="addEditPassword" type="password" placeholder="Password" autocomplete="new-password" />
                        </div>
                        <div class="uf-field">
                            <label>Confirm Password</label>
                            <input id="addEditConfirmPassword" type="password" placeholder="Confirm password" autocomplete="new-password" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="dp-btn dp-btn-outline" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="dp-btn dp-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save User</button>
            </div>
        </div>
    </div>
</div>
