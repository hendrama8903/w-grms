<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-card">
                <div class="box-header dp-toolbar">
                    <div class="dp-toolbar-left">
                        @if ((bool)ViewData["Add"])
                        {
                            <button type="button" class="dp-btn dp-btn-primary" id="btn_add"><i class="fa fa-plus"></i> Add User</button>
                        }
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_toggleFilters"><i class="fa fa-filter"></i> More Filters</button>
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
                        <label class="dp-btn dp-btn-outline" style="margin:0;font-weight:500;">
                            <input type="checkbox" id="chkShowDeleted" style="margin:0 4px 0 0;" /> Show inactive
                        </label>
                    </div>
                    <div class="dp-toolbar-right">
                        <a class="dp-btn dp-btn-outline" href="@Url.Action("DownloadExcel", "User")"><i class="fa fa-download"></i> Export</a>
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-cog"></i></button>
                    </div>
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
